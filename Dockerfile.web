# syntax=docker/dockerfile:1
FROM node:22-alpine AS build

ARG APP
WORKDIR /src
COPY apps/${APP}/package*.json ./
RUN npm ci
COPY apps/${APP}/ ./

# Vite reads VITE_* variables at build time and inlines them into the bundle,
# so these must be known when the image is built rather than when it starts.
# That is the cost of shipping a static SPA: one image per environment, not one
# image promoted between them.
ARG VITE_APP_URL=""
ENV VITE_APP_URL=$VITE_APP_URL

# The path prefix this app is served under. Empty means the root.
ARG VITE_BASE="/"
ENV VITE_BASE=$VITE_BASE

RUN npm run build

# nginx-unprivileged rather than the standard image: it runs as a non-root user
# out of the box, so no securityContext gymnastics in the Helm chart.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
# The nginx image substitutes environment variables into any .template file
# in this directory at startup, so the path prefix is a deploy-time value
# rather than a second image.
COPY deploy/nginx/spa.conf.template /etc/nginx/templates/default.conf.template
ENV BASE_PATH=""
EXPOSE 8080
