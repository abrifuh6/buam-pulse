# syntax=docker/dockerfile:1
# Build stage: compile the React app to static files.
FROM node:22-alpine AS build
WORKDIR /src
ARG APP

# Vite reads VITE_* variables at build time and inlines them into the bundle,
# so the dashboard URL has to be known when the image is built rather than when
# the container starts. That is the cost of a static SPA: one image per
# environment, not one image promoted between them.
ARG VITE_APP_URL=""
ENV VITE_APP_URL=$VITE_APP_URL
COPY apps/${APP}/package*.json ./
RUN npm ci
COPY apps/${APP}/ ./
RUN npm run build

# Runtime: nginx serving static files. Not distroless — nginx needs a shell-less
# but complete image; nginx:alpine is small (~45MB) and hardened enough here.
# nginx-unprivileged: same nginx, but already configured to run as UID 101 on
# port 8080 with writable pid/cache paths. The stock nginx image needs root to
# bind :80 and to write /var/run/nginx.pid.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
