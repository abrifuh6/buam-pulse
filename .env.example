DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse?sslmode=disable
REDIS_URL=redis://localhost:6379/0
API_PORT=8080
LOG_LEVEL=info

# Secret used to sign login tokens. Any long random string locally; in AWS this
# comes from Secrets Manager, never from a file.
JWT_SECRET=change-me-locally-to-anything-long
METRICS_PORT=9090