DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse?sslmode=disable
REDIS_URL=redis://localhost:6379/0
API_PORT=8080
LOG_LEVEL=info

# Secret used to sign login tokens. Any long random string locally; in AWS this
# comes from Secrets Manager, never from a file.
JWT_SECRET=change-me-locally-to-anything-long
METRICS_PORT=9090

# Origins allowed to call the API from a browser (dashboard 5173, status page 5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Alert delivery. Local dev uses MailHog (see docker-compose); stage/prod use SES.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=alerts@pulse.buamtech.io
# Two different public addresses, because the dashboard and the status pages are
# separate origins (ADR 0003). Verification links must reach the API; alert
# emails link to the customer's status page.
APP_URL=http://localhost:8080
STATUS_URL=http://localhost:5174

# true ONLY when the API is exclusively reachable through an ingress/ALB that
# sets X-Forwarded-For. Otherwise clients can spoof their IP past rate limits.
TRUST_PROXY=false
