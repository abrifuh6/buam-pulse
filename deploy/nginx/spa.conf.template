server {
    listen       8080;
    server_name  _;
    root   /usr/share/nginx/html;
    index  index.html;

    # The path prefix this app is served under, if any.
    #
    # An ingress routing /app here does not strip the prefix, so nginx receives
    # /app/assets/index.js and looks for html/app/assets/index.js — which does
    # not exist. It falls through to index.html and returns HTML with a 200, so
    # the browser gets a page where it expected JavaScript and refuses it on
    # MIME type. The symptom is a blank screen.
    #
    # BASE_PATH is substituted at container start. When it is empty this
    # rewrite is a no-op on paths that already have no prefix, which is why one
    # location block can serve both cases — two blocks would collide on "/".
    location / {
        rewrite ^${BASE_PATH}/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }

    # Hashed asset filenames are immutable — cache them hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached, or users get a stale app after a deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
}
